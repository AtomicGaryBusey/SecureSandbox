# Canonical portable Host SSH configuration. OpenSSH expands %d to the local
# operator's home directory on each admitted Mac.
Host sandbox-gateway
    HostName 10.211.55.16
    User labadmin
    IdentityAgent /tmp/secure-sandbox-ssh-agent.sock
    IdentityFile %d/SecureSandbox/runs/provisioning_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile %d/SecureSandbox/runs/known_hosts

Host sandbox-gateway-control
    HostName 10.211.55.16
    User securectl
    IdentityAgent /tmp/secure-sandbox-control-ssh-agent.sock
    IdentityFile %d/SecureSandbox/runs/control_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile %d/SecureSandbox/runs/known_hosts

Host sandbox-research-admin
    HostName 172.30.10.2
    User labadmin
    ProxyJump sandbox-gateway
    IdentityAgent /tmp/secure-sandbox-ssh-agent.sock
    IdentityFile %d/SecureSandbox/runs/provisioning_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile %d/SecureSandbox/runs/known_hosts

Host sandbox-research
    HostName 172.30.10.2
    User agent
    ProxyJump sandbox-gateway
    IdentityAgent /tmp/secure-sandbox-ssh-agent.sock
    IdentityFile %d/SecureSandbox/runs/provisioning_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile %d/SecureSandbox/runs/known_hosts

Host sandbox-research-control
    HostName 172.30.10.2
    User securectl
    ProxyJump sandbox-gateway
    IdentityAgent /tmp/secure-sandbox-control-ssh-agent.sock
    IdentityFile %d/SecureSandbox/runs/control_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile %d/SecureSandbox/runs/known_hosts

Host sandbox-target-admin
    HostName 172.30.20.2
    User labadmin
    ProxyJump sandbox-gateway,sandbox-research-admin
    IdentityAgent /tmp/secure-sandbox-ssh-agent.sock
    IdentityFile %d/SecureSandbox/runs/provisioning_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile %d/SecureSandbox/runs/known_hosts

Host sandbox-target-control
    HostName 172.30.20.2
    User securectl
    ProxyJump sandbox-gateway,sandbox-research-admin
    IdentityAgent /tmp/secure-sandbox-control-ssh-agent.sock
    IdentityFile %d/SecureSandbox/runs/control_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile %d/SecureSandbox/runs/known_hosts
