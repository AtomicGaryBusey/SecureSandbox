# Canonical Host SSH configuration. Public client identities and pinned guest
# host keys are selected only through the root-owned machine trust projection.
Host sandbox-gateway
    HostName gateway.securesandbox.invalid
    HostKeyAlias SecureSandbox-Gateway
    CheckHostIP no
    ProxyCommand /usr/bin/python3 -I /usr/local/libexec/secure-sandbox-host/current/control_client proxy-gateway --port %p
    User labadmin
    IdentityAgent /tmp/secure-sandbox-ssh-agent.sock
    IdentityFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/provisioning_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/known_hosts

Host sandbox-gateway-control
    HostName gateway.securesandbox.invalid
    HostKeyAlias SecureSandbox-Gateway
    CheckHostIP no
    ProxyCommand /usr/bin/python3 -I /usr/local/libexec/secure-sandbox-host/current/control_client proxy-gateway --port %p
    User securectl
    IdentityAgent /tmp/secure-sandbox-control-ssh-agent.sock
    IdentityFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/control_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/known_hosts

Host sandbox-research-admin
    HostName 172.30.10.2
    HostKeyAlias SecureSandbox-Research
    CheckHostIP no
    User labadmin
    ProxyJump sandbox-gateway
    IdentityAgent /tmp/secure-sandbox-ssh-agent.sock
    IdentityFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/provisioning_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/known_hosts

Host sandbox-research
    HostName 172.30.10.2
    HostKeyAlias SecureSandbox-Research
    CheckHostIP no
    User agent
    ProxyJump sandbox-gateway
    IdentityAgent /tmp/secure-sandbox-ssh-agent.sock
    IdentityFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/provisioning_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/known_hosts

Host sandbox-research-control
    HostName 172.30.10.2
    HostKeyAlias SecureSandbox-Research
    CheckHostIP no
    User securectl
    ProxyJump sandbox-gateway
    IdentityAgent /tmp/secure-sandbox-control-ssh-agent.sock
    IdentityFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/control_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/known_hosts

Host sandbox-target-admin
    HostName 172.30.20.2
    HostKeyAlias SecureSandbox-Target
    CheckHostIP no
    User labadmin
    ProxyJump sandbox-gateway,sandbox-research-admin
    IdentityAgent /tmp/secure-sandbox-ssh-agent.sock
    IdentityFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/provisioning_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/known_hosts

Host sandbox-target-control
    HostName 172.30.20.2
    HostKeyAlias SecureSandbox-Target
    CheckHostIP no
    User securectl
    ProxyJump sandbox-gateway,sandbox-research-admin
    IdentityAgent /tmp/secure-sandbox-control-ssh-agent.sock
    IdentityFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/control_key.pub
    IdentitiesOnly yes
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /usr/local/var/lib/secure-sandbox/host-ssh-trust/current/known_hosts
