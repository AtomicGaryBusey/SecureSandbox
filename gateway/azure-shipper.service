[Unit]
Description=SecureSandbox Azure metadata shipper
After=network-online.target telemetry-receiver.service sys-subsystem-net-devices-uplink0.device
Wants=network-online.target sys-subsystem-net-devices-uplink0.device

[Service]
Type=simple
User=azure-shipper
Group=azure-shipper
SupplementaryGroups=telemetry
ExecStart=/usr/local/libexec/secure-sandbox/azure_shipper.py --config /etc/secure-sandbox/azure-shipper.json
LoadCredentialEncrypted=client_secret:/etc/credstore.encrypted/azure-shipper.client_secret
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ReadOnlyPaths=/var/lib/secure-sandbox/telemetry
ReadWritePaths=/var/lib/secure-sandbox/azure-shipper
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNetworkInterfaces=lo uplink0
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
UMask=0077
LimitNOFILE=128
LimitCORE=0
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
