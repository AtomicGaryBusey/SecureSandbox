[Unit]
Description=SecureSandbox encrypted conversation Azure shipper
After=network-online.target conversation-receiver.service sys-subsystem-net-devices-uplink0.device
Wants=sys-subsystem-net-devices-uplink0.device

[Service]
Type=simple
User=conversation-azure
Group=conversation-azure
SupplementaryGroups=conversation-archive
ExecStart=/usr/local/libexec/secure-sandbox/conversation_azure_shipper.py
LoadCredentialEncrypted=client_secret:/etc/credstore.encrypted/conversation-azure.client_secret
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/secure-sandbox/conversation-azure.json
ReadWritePaths=/var/lib/secure-sandbox/conversation-spool
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNetworkInterfaces=lo uplink0
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitNOFILE=64
LimitCORE=0
MemoryMax=128M
TasksMax=8

[Install]
WantedBy=multi-user.target
