[Unit]
Description=SecureSandbox opaque conversation archive receiver
After=network-online.target sys-subsystem-net-devices-ctl0.device
Wants=sys-subsystem-net-devices-ctl0.device

[Service]
Type=simple
User=conversation-receiver
Group=conversation-archive
ExecStart=/usr/local/libexec/secure-sandbox/conversation_receiver.py --config /etc/secure-sandbox/conversation-receiver.json
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/secure-sandbox/conversation-receiver.json /etc/secure-sandbox/telemetry
ReadWritePaths=/var/lib/secure-sandbox/conversation-spool
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNetworkInterfaces=lo ctl0
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027
LimitNOFILE=64
LimitCORE=0
MemoryMax=96M
TasksMax=8

[Install]
WantedBy=multi-user.target
