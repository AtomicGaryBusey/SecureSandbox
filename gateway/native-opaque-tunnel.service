[Unit]
Description=SecureSandbox native vendor opaque CONNECT tunnel
After=network-online.target sys-subsystem-net-devices-ctl0.device sys-subsystem-net-devices-uplink0.device
Wants=network-online.target sys-subsystem-net-devices-ctl0.device sys-subsystem-net-devices-uplink0.device
ConditionPathExists=/var/lib/secure-sandbox/native-egress/active.json
ConditionPathExists=!/var/lib/secure-sandbox/native-egress-control/gateway-install.pending.json

[Service]
Type=simple
User=native-tunnel
Group=native-tunnel
SupplementaryGroups=
ExecStart=/usr/local/libexec/secure-sandbox/native_opaque_tunnel.py
# The durable consumption ledger tombstones every started grant. A restart
# cannot reuse the active grant; recovery requires a fresh Touch ID-bound grant.
Restart=no
RuntimeMaxSec=14400
StateDirectory=native-opaque-tunnel
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ReadOnlyPaths=/var/lib/secure-sandbox/native-egress/active.json
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNetworkInterfaces=ctl0 uplink0
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
UMask=0077
LimitNOFILE=256
LimitCORE=0
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
