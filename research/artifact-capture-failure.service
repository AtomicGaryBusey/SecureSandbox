[Unit]
Description=SecureSandbox artifact capture emergency stop

[Service]
Type=oneshot
User=root
Group=conversation-shipper
RuntimeDirectory=secure-sandbox
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/touch /run/secure-sandbox/artifact-capture-fatal
ExecStart=/usr/bin/logger --tag secure-sandbox {"event":"artifact_capture_failed","error":"collector_unit_failure"}
ExecStart=/usr/local/libexec/secure-sandbox/run_lease_watchdog.py emergency
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_KILL
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_KILL
ProtectControlGroups=no
ProtectHome=tmpfs
ReadOnlyPaths=/etc/secure-sandbox/conversation-recipient.txt
ReadWritePaths=/run/secure-sandbox /var/lib/secure-sandbox/run-lifecycle /var/lib/secure-sandbox/conversation-capture /var/lib/secure-sandbox/conversation-outbox /sys/fs/cgroup
SystemCallArchitectures=native
SystemCallFilter=@system-service
