[Unit]
Description=SecureSandbox bounded CodeGraph query service
After=local-fs.target

[Service]
Type=simple
User=codegraph-query
Group=codegraph-runtime
SupplementaryGroups=codegraph-client agent
RuntimeDirectory=secure-sandbox-codegraph
RuntimeDirectoryMode=0755
ExecStart=/usr/local/libexec/secure-sandbox/codegraph_query_service.py
Restart=on-failure
RestartSec=2
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/secure-sandbox/codegraph-analyses
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
MemoryMax=768M
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
