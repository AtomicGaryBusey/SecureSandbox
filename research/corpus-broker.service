[Unit]
Description=SecureSandbox trusted receipt-producing corpus broker
After=local-fs.target

[Service]
Type=simple
User=corpus-broker
Group=agent
SupplementaryGroups=evidence-receipts
ExecStart=/usr/local/libexec/secure-sandbox/corpus_broker.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
RuntimeDirectory=secure-sandbox-corpus
RuntimeDirectoryMode=0750
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/agent/research-workspace
ReadWritePaths=/var/lib/secure-sandbox/evidence-receipts/corpus
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
