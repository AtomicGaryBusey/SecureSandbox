[Unit]
Description=SecureSandbox bounded candidate findings broker
After=local-fs.target

[Service]
Type=simple
User=findings-broker
Group=agent
SupplementaryGroups=evidence-receipts findings-broker
ExecStart=/usr/local/libexec/secure-sandbox/findings_broker.py
Restart=on-failure
RestartSec=2
UMask=0007
RuntimeDirectory=secure-sandbox-findings
RuntimeDirectoryMode=0750
StateDirectory=secure-sandbox/findings
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/agent/research-workspace
ReadOnlyPaths=/var/lib/secure-sandbox/evidence-receipts
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
