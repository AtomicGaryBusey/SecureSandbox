[Unit]
Description=SecureSandbox root-owned run lease expiry watchdog
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/secure-sandbox/run_lease_watchdog.py
Restart=on-failure
RestartSec=1s
User=root
Group=conversation-shipper
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_KILL
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_KILL
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=no
ProtectHome=tmpfs
BindReadOnlyPaths=/home/agent/.claude/projects
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/secure-sandbox/conversation-recipient.txt
ReadWritePaths=/run/secure-sandbox /var/lib/secure-sandbox/run-lifecycle /var/lib/secure-sandbox/conversation-capture /var/lib/secure-sandbox/conversation-outbox /sys/fs/cgroup
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @raw-io @reboot @resources @swap
UMask=0077
LimitNOFILE=128
LimitCORE=0
MemoryMax=64M
TasksMax=8

[Install]
WantedBy=multi-user.target

