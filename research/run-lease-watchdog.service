[Unit]
Description=SecureSandbox root-owned run lease expiry watchdog
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/secure-sandbox/run_lease_watchdog.py
Restart=on-failure
RestartSec=1s
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_KILL
AmbientCapabilities=CAP_KILL
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/secure-sandbox
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @obsolete @raw-io @reboot @resources @swap
UMask=0077
LimitNOFILE=128
LimitCORE=0
MemoryMax=64M
TasksMax=8

[Install]
WantedBy=multi-user.target

