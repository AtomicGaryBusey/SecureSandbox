[Unit]
Description=SecureSandbox PKI expiry evidence check
After=time-sync.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/secure-sandbox/pki_lifecycle.py expiry
StandardOutput=journal
StandardError=journal
SyslogIdentifier=secure-sandbox-pki
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
